# Konfigurasi untuk tahap pertama: diakses lewat alamat IP, belum punya domain.
#
# HTTPS tetap wajib, bukan pilihan. Cookie sesi aplikasi ini ditandai `Secure`
# di mode produksi, jadi lewat HTTP biasa login tidak akan pernah berhasil —
# peramban menolak mengirim cookienya kembali. Di luar itu, tanpa HTTPS kata
# sandi dan seluruh angka keuangan melintas terbuka di sepanjang jalur.
#
# Let's Encrypt tidak menerbitkan sertifikat untuk alamat IP, jadi Caddy
# membuat sertifikatnya sendiri. Peramban akan memperingatkan sekali pada
# kunjungan pertama — lanjutkan saja. Lalu lintasnya tetap terenkripsi penuh;
# yang tidak bisa dibuktikan hanyalah "server ini benar milik siapa", dan itu
# memang pertanyaan yang hanya bisa dijawab oleh nama domain.
#
# Pasang dengan:
#   sudo cp deploy/Caddyfile-ip /etc/caddy/Caddyfile
#   sudo nano /etc/caddy/Caddyfile      # ganti GANTI_DENGAN_IP
#   sudo systemctl reload caddy
#
# Begitu domainnya siap, ganti seluruh berkas ini dengan deploy/Caddyfile dan
# muat ulang Caddy. Tidak ada yang perlu diubah di sisi aplikasi.

https://GANTI_DENGAN_IP {
	# Sertifikat terbitan Caddy sendiri. Tanpa baris ini Caddy akan mencoba
	# Let's Encrypt, gagal, lalu mengulang-ulang permintaannya.
	tls internal

	encode zstd gzip

	# Alamat asli pengunjung diteruskan ke aplikasi, dipakai membatasi
	# percobaan menebak kata sandi.
	reverse_proxy 127.0.0.1:3000 {
		header_up X-Forwarded-For {remote_host}
	}

	header {
		# Strict-Transport-Security sengaja TIDAK dipasang di sini. Peramban
		# mengabaikannya untuk alamat IP, dan memasangnya hanya menyiapkan
		# jebakan: begitu pindah ke domain, aturan yang terlanjur tersimpan
		# bisa mengunci akses tanpa sebab yang kelihatan.
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}

	log {
		output file /var/log/caddy/hita.log {
			roll_size 10MB
			roll_keep 10
		}
	}
}

# Yang datang lewat http:// dialihkan ke https://, supaya tidak ada yang
# tanpa sadar memakai jalur terbuka.
http://GANTI_DENGAN_IP {
	redir https://{host}{uri} permanent
}
